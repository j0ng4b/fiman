    },
    {
      "value": "\"amount\" > 0",
      "name": "transactions_amount_positive_ck",
      "entityType": "checks",
      "schema": "public",
      "table": "transactions"
    },
    {
      "value": "\"paid_amount\" IS NULL OR \"paid_amount\" > 0",
      "name": "transactions_paid_amount_positive_ck",
      "entityType": "checks",
      "schema": "public",
      "table": "transactions"
    },
    {
      "value": "(\"status\" = 'C'\n                    AND \"transaction_date\" IS NOT NULL\n                    AND \"paid_amount\" IS NOT NULL)\n                OR (\"status\" <> 'C'\n                    AND \"transaction_date\" IS NULL\n                    AND \"paid_amount\" IS NULL)\n            ",
      "name": "transactions_status_fields_ck",
      "entityType": "checks",
      "schema": "public",
      "table": "transactions"
    },
    {
      "value": "\"reversal_date\" IS NULL\n                OR (\"status\" = 'C'\n                AND \"reversal_date\" >= \"transaction_date\")",
      "name": "transactions_reversal_ck",
      "entityType": "checks",
      "schema": "public",
      "table": "transactions"
    },
    {
      "value": "EXTRACT(day from \"accounting_month\") = 1\n                AND \"accounting_month\" <= \"due_date\"",
      "name": "transactions_accounting_month_ck",
      "entityType": "checks",
      "schema": "public",
      "table": "transactions"
    },
    {
      "value": "(\"installment_id\" IS NULL) = (\"installment_number\" IS NULL)",
